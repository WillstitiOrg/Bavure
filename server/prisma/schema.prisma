generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Citoyen {
  id             Int       @id @default(autoincrement())
  nom            String    @unique
  password       String
  abonne         Boolean   @default(false)
  PremierAbonnement DateTime?
  finAbonnement  DateTime?
  accesParutions    Int[]
  futurAbonnement Boolean @default(false)
  nbAbonnement    Int     @default(0)
  nouveau         Boolean @default(false)
}